{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixoa.github.io/crackspread/schemas/config.schema.json",
  "title": "site/config.json",
  "description": "Central configuration read by the Python scripts and the frontend (ARCHITECTURE §1).",
  "type": "object",
  "required": ["site_name", "site_url", "language", "languages_available", "timezone_display",
               "donate_url", "donate_cta_variant", "ai_provider", "ai_model", "stale_after_hours",
               "balance_thresholds", "news_max_items", "news_max_age_hours", "news_queries", "news_feeds",
               "news_keywords", "news_topics", "update_schedule_utc", "crack_levels", "inspiration"],
  "properties": {
    "site_name": {"type": "string", "minLength": 1},
    "site_url": {"$ref": "#/$defs/url"},
    "repo_url": {"$ref": "#/$defs/url"},
    "language": {"type": "string", "pattern": "^[a-z]{2}$"},
    "languages_available": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z]{2}$"}},
    "show_language_toggle": {"type": "boolean"},
    "timezone_display": {"type": "string", "minLength": 1},
    "donate_url": {"type": "string", "pattern": "^(https?://\\S+)?$"},
    "donate_provider_label": {"type": "string"},
    "donate_cta_variant": {"type": "integer", "minimum": 0, "maximum": 3},
    "ai_provider": {"type": "string", "enum": ["gemini", "anthropic", "none"]},
    "ai_model": {"type": "string"},
    "stale_after_hours": {
      "type": "object",
      "required": ["prices", "steo", "news", "country", "summary"],
      "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
    },
    "balance_thresholds": {
      "type": "object",
      "required": ["deficit", "surplus"],
      "properties": {
        "deficit": {"type": "number"},
        "surplus": {"type": "number"}
      },
      "additionalProperties": true
    },
    "news_max_items": {"type": "integer", "minimum": 1},
    "news_max_age_hours": {"type": "number", "exclusiveMinimum": 0},
    "news_queries": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "news_feeds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "url"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 1},
          "url": {"$ref": "#/$defs/url"},
          "filter": {"type": "boolean"},
          "topics": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "news_keywords": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "news_topics": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "update_schedule_utc": {
      "type": "object",
      "required": ["hours", "minute"],
      "properties": {
        "hours": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 23}},
        "minute": {"type": "integer", "minimum": 0, "maximum": 59}
      },
      "additionalProperties": true
    },
    "crack_levels": {
      "type": "object",
      "required": ["labels", "percentile_cuts"],
      "properties": {
        "labels": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "minLength": 1}},
        "percentile_cuts": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 100}}
      },
      "additionalProperties": true
    },
    "inspiration": {
      "type": "object",
      "required": ["title", "author", "url"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "url": {"$ref": "#/$defs/url"},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      },
      "additionalProperties": true
    },
    "source_links": {
      "description": "Home pages of the data sources, linked from the footer's sources & licences list.",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/url"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "url": {"type": "string", "pattern": "^https?://\\S+$"}
  }
}
